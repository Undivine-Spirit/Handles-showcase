# Copy to .env (gitignored) and fill in. docker-compose.yml reads this.

# How often the daemon runs a reconciliation pass.
RECONCILE_INTERVAL_MINUTES=15

# Whether to actually commit+push catalog changes back to GitHub after a
# pass. Leave "false" until you're ready to let the daemon write to the
# real repo - e.g. while first testing the container itself.
GIT_SYNC_ENABLED=false

# The catalog API (core/bin/api_server.dart) - what the app talks to now
# instead of keeping its own git clone (docs/PROJECT_PLAN.md section 2,
# 2026-09-02). Shares the same CATALOG_CHECKOUT_PATH mount as the daemon
# below, so both processes see the same files in real time.
API_PORT=8080

# Required - the server refuses to start without this. Generate a real
# random value, e.g. `openssl rand -hex 32`. This is the one thing
# protecting your catalog if the server is reachable from the open
# internet - see docs/DEPLOYMENT.md for why it MUST sit behind HTTPS.
API_AUTH_TOKEN=

# Same idea as GIT_SYNC_ENABLED above, for the API server's own writes.
API_GIT_PUSH=false

# Where docker-compose finds the things it mounts into the container.
# Defaults (./catalog, ./core/secrets) work if you're running
# docker-compose from a real clone of this repo on the host machine -
# override these if your self-hosted setup checks the repo out
# elsewhere.
# CATALOG_CHECKOUT_PATH=./catalog
# SECRETS_HOST_PATH=./core/secrets

# The webhook receiver (core/bin/webhook_server.dart) - the one service in
# this deployment meant to be reachable from the public internet (via
# `tailscale funnel`, not the tailnet-only `tailscale serve` the catalog
# API uses), since eBay/Walmart's own servers call it. See
# docs/DEPLOYMENT.md's webhook entry.
WEBHOOK_PORT=8081

# How often reconcile-daemon wakes up just to check whether the webhook
# receiver dropped a trigger file, instead of waiting out the full
# RECONCILE_INTERVAL_MINUTES.
TRIGGER_CHECK_INTERVAL_SECONDS=5

# eBay's Marketplace Account Deletion notification (mandatory compliance
# topic - eBay's order/sale webhooks don't reliably fire for ordinary
# sellers, so that's all this route handles; orders still come from
# EbayAdapter's normal poll). Leave both unset to disable this route - the
# webhook receiver logs that and returns 503 on it rather than refusing to
# start, as long as Walmart's is configured.
EBAY_VERIFICATION_TOKEN=
# Must exactly match the URL registered with eBay's createDestination call
# - it's part of the challenge-response hash, not just a label.
EBAY_WEBHOOK_ENDPOINT_URL=

# Walmart's PO_CREATED webhook (a real, working order notification, unlike
# eBay's). Used to verify the HMAC-SHA256 signature Walmart sends on each
# call. Leave unset to disable this route.
WALMART_CLIENT_SECRET=
# Whatever header name you chose as `authHeaderName` when creating the
# Walmart subscription - must match exactly.
WALMART_WEBHOOK_HEADER_NAME=X-Handles-Signature
